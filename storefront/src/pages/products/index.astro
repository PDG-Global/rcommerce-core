---
import Layout from '../../layouts/Layout.astro';
import { brand, content } from '../../lib/brand';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import type { Product } from '../../lib/types';
import { API_BASE } from '../../lib/api';

const PREFERRED_ORDER = content.catalog.categoryOrder;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';

let products: Product[] = [];
let categories: { id: string; name: string; slug: string }[] = [];
let error: string | null = null;

try {
  const [productsRes, categoriesRes] = await Promise.all([
    fetch(q ? `${API_BASE}/products?q=${encodeURIComponent(q)}` : `${API_BASE}/products`),
    fetch(`${API_BASE}/categories`),
  ]);
  if (!productsRes.ok) throw new Error(`API returned ${productsRes.status}`);
  const data = await productsRes.json();
  products = (data.products || []).filter((p: Product) => p.is_active && p.product_type !== 'bundle');
  if (categoriesRes.ok) {
    const catData = await categoriesRes.json();
    categories = (catData.categories || [])
      .filter((c: { slug: string }) => !content.hiddenCategories.includes(c.slug))
      .sort((a: { slug: string }, b: { slug: string }) => {
        const ai = PREFERRED_ORDER.indexOf(a.slug);
        const bi = PREFERRED_ORDER.indexOf(b.slug);
        return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
      });
  }
} catch (e: any) {
  error = e.message || 'Failed to load products';
}

const title = q ? `Search: “${q}”` : 'All Products';
const description = q
  ? `Search results for “${q}” — ${brand.name} ${content.catalog.line}.`
  : `Shop ${brand.name} — premium ${content.catalog.line}.`;
---

<Layout title={title} description={description}>
  <Nav />
  <main class="flex-1">
    <div class="bg-rcommerce-50 border-b border-rcommerce-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
        <p class="eyebrow text-xl">Shop</p>
        <h1 class="font-serif text-4xl md:text-5xl font-semibold text-rcommerce-900 mt-1">{title}</h1>
        {q && (
          <a href="/products" class="mt-3 inline-block text-sm text-rcommerce-accent link-underline">
            Clear search
          </a>
        )}
        <div class="mt-8 flex flex-wrap items-center gap-2">
          <a
            href="/products"
            class="px-4 py-2 text-[12px] font-semibold uppercase tracking-button border transition-colors bg-rcommerce-900 text-white border-rcommerce-900"
          >
            All
          </a>
          {categories.map((cat) => (
            <a
              href={`/products/${cat.slug}`}
              class="px-4 py-2 text-[12px] font-semibold uppercase tracking-button border transition-colors bg-white text-rcommerce-700 border-rcommerce-300 hover:border-rcommerce-900"
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      {error && (
        <div class="p-4 bg-rcommerce-danger/10 text-rcommerce-danger mb-8">{error}</div>
      )}

      {!error && products.length === 0 && (
        <div class="py-20 text-center">
          {q ? (
            <>
              <p class="font-serif italic text-2xl text-rcommerce-500">
                No products found for “{q}”.
              </p>
              <p class="mt-3 text-sm text-rcommerce-600">
                Try a different search term or{' '}
                <a href="/products" class="text-rcommerce-accent link-underline">browse all products</a>.
              </p>
            </>
          ) : (
            <p class="font-serif italic text-2xl text-rcommerce-500">No products found.</p>
          )}
        </div>
      )}

      <p class="text-sm text-rcommerce-500 mb-6">{products.length} {products.length === 1 ? 'product' : 'products'}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
