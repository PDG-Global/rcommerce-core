---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroAddToCart from '../islands/HeroAddToCart';
import type { Product } from '../lib/types';
import { API_BASE } from '../lib/api';
import { productUrl } from '../lib/url';
import { brand, content } from '../lib/brand';
import { pageOverlay } from '../lib/brand/pageOverlays';

// A store may ship a bespoke homepage overlay (e.g. a full-bleed media hero
// + kinetic strip layout) that replaces the generic homepage entirely.
const HomeOverlay = pageOverlay(`${brand.slug}-home`);

/// Brand ordering preference for the homepage category tiles.
const PREFERRED_ORDER = content.catalog.categoryOrder;

let products: Product[] = [];
let categories: { id: string; name: string; slug: string }[] = [];
let categoryImages: Record<string, string> = {};
let error: string | null = null;

try {
  const [productsRes, categoriesRes] = await Promise.all([
    fetch(`${API_BASE}/products`),
    fetch(`${API_BASE}/categories`),
  ]);
  if (!productsRes.ok) throw new Error(`API returned ${productsRes.status}`);
  const data = await productsRes.json();
  products = (data.products || []).filter((p: Product) => p.is_active && p.product_type !== 'bundle');
  if (categoriesRes.ok) {
    const catData = await categoriesRes.json();
    const all = (catData.categories || []).filter(
      (c: { slug: string }) => !content.hiddenCategories.includes(c.slug),
    );
    categories = all.sort((a: { slug: string }, b: { slug: string }) => {
      const ai = PREFERRED_ORDER.indexOf(a.slug);
      const bi = PREFERRED_ORDER.indexOf(b.slug);
      return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
    }).slice(0, 3);
  }
} catch (e: any) {
  error = e.message || 'Failed to load products';
}

await Promise.all(
  categories.map(async (cat) => {
    try {
      const res = await fetch(`${API_BASE}/products?category=${encodeURIComponent(cat.slug)}`);
      if (!res.ok) return;
      const data = await res.json();
      const withImage = (data.products || []).find(
        (p: Product) => p.is_active && (p.image || p.images?.[0]?.src),
      );
      const src = withImage?.image ?? withImage?.images?.[0]?.src;
      if (src) categoryImages[cat.slug] = src;
    } catch {
      // ignore
    }
  }),
);

const popular = [...products.filter((p) => p.is_active && p.inventory_quantity > 0)]
  .sort(() => Math.random() - 0.5)
  .slice(0, 4);
const heroProduct = products.find((p) => p.slug === brand.heroProductSlug);
const heroImage = heroProduct ? heroProduct.image ?? heroProduct.images?.[0]?.src : null;

// Promotional bundle section (products from the brand's promo category).
let promoProducts: Product[] = [];
try {
  const promoCategory = content.home.promoCategory;
  const res = promoCategory
    ? await fetch(`${API_BASE}/products?category=${encodeURIComponent(promoCategory)}`)
    : null;
  if (res && res.ok) {
    const data = await res.json();
    promoProducts = (data.products || [])
      .filter((p: Product) => p.is_active && p.inventory_quantity > 0)
      .slice(0, 4);
  }
} catch {
  // promo section renders without products
}
---

<Layout title={content.home.metaTitle} description={content.home.metaDescription} image={brand.logo}>
  {HomeOverlay ? (
    <HomeOverlay products={popular} categories={categories} categoryImages={categoryImages} error={error} />
  ) : (
  <>
  <Nav />
  <main class="flex-1">
    {content.home.wideHero ? (
      <>
        {/* Full-width hero variant: video, then centered headline + CTA,
            then the optional image-left / brand-panel-right block. */}
        <section>
          <div class="relative w-full" style="padding-top: 56.25%;">
            <iframe
              src={brand.heroVideoUrl}
              loading="lazy"
              class="absolute inset-0 w-full h-full"
              style="border: none; display: block;"
              allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
              allowfullscreen
              title={`${brand.name} — wheels in motion`}
            ></iframe>
          </div>
          <div class="px-6 sm:px-10 py-14 lg:py-20 text-center">
            <h1 class="font-serif font-extrabold text-rcommerce-900 text-4xl md:text-5xl xl:text-6xl leading-[1.1] tracking-tight max-w-3xl mx-auto">
              {content.home.wideHero.before}{' '}
              <span class="bg-rcommerce-highlight px-2 whitespace-nowrap">{content.home.wideHero.highlight}</span>{' '}
              {content.home.wideHero.after}
            </h1>
            <div class="mt-8">
              <a
                href={content.home.wideHero.ctaHref}
                class="inline-block text-white font-semibold uppercase text-[14px] tracking-button py-4 px-10 hover:opacity-90 transition-opacity"
                style={`background-color: ${content.home.wideHero.ctaColor};`}
              >
                {content.home.wideHero.ctaLabel}
              </a>
            </div>
          </div>
        </section>

        {(content.home.panelImage || content.home.yearsPanel) && (
          <section class="grid grid-cols-1 lg:grid-cols-2">
            {content.home.panelImage && (
              <div class="relative min-h-[300px] lg:min-h-[460px] bg-rcommerce-100">
                <img
                  src={content.home.panelImage.src}
                  alt={content.home.panelImage.alt}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            {content.home.yearsPanel && (
              <div class="bg-rcommerce-primary text-white px-6 sm:px-10 lg:px-16 py-16 lg:py-24 flex flex-col justify-center">
                <h2 class="font-serif text-3xl md:text-4xl font-semibold">
                  {content.home.yearsPanel.heading}
                </h2>
                <p class="mt-6 text-rcommerce-100 leading-relaxed">
                  {content.home.yearsPanel.body}
                </p>
              </div>
            )}
          </section>
        )}
      </>
    ) : (
    <!-- Hero: split video + headline | pink featured product -->
    <section class="grid grid-cols-1 lg:grid-cols-2 lg:min-h-[850px]">
      <!-- Left: video, then pink headline + Shop Wheels -->
      <div class="flex flex-col justify-center">
        <div class="relative w-full" style="padding-top: 56.25%;">
          <iframe
            src={brand.heroVideoUrl}
            loading="lazy"
            class="absolute inset-0 w-full h-full"
            style="border: none; display: block;"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
            allowfullscreen
            title={`${brand.name} — wheels in motion`}
          ></iframe>
        </div>
        <div class="px-6 sm:px-10 lg:pl-[14%] pt-10 lg:pt-16 pb-12 lg:pb-16">
          <h2 class="font-serif italic font-light text-rcommerce-primary text-4xl md:text-6xl leading-none">
            {content.home.hero.kicker}
          </h2>
          <h1 class="font-serif font-bold text-rcommerce-primary text-6xl md:text-8xl leading-[0.9] mt-1">
            {content.home.hero.headline}
          </h1>
          <div class="mt-8">
            <a href={content.home.hero.ctaHref} class="btn-accent">{content.home.hero.ctaLabel}</a>
          </div>
        </div>
      </div>

      <!-- Right: pink hero product -->
      <div class="bg-rcommerce-primary text-white flex items-center justify-center px-6 sm:px-16 py-16 lg:py-0">
        {heroProduct && (
          <div class="w-full max-w-sm text-center">
            <a href={productUrl(heroProduct)} class="group block">
              <div class="aspect-square bg-white overflow-hidden">
                {heroImage && (
                  <img
                    src={heroImage}
                    alt={heroProduct.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                )}
              </div>
              <h2 class="font-serif italic text-lg leading-snug mt-5 group-hover:underline">
                {heroProduct.title}
              </h2>
            </a>
            <p class="mt-2 text-xl font-light">
              {heroProduct.currency} {heroProduct.price}
            </p>
            <HeroAddToCart client:load product={heroProduct} />
          </div>
        )}
      </div>
    </section>
    )}

    <!-- Category tiles (hidden for brands that opt out via content) -->
    {content.home.showCategoryTiles && categories.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {categories.map((cat) => (
            <a
              href={`/products/${cat.slug}`}
              class="group relative aspect-[3/4] bg-rcommerce-100 overflow-hidden"
            >
              {categoryImages[cat.slug] && (
                <img
                  src={categoryImages[cat.slug]}
                  alt={cat.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-rcommerce-900/70 via-rcommerce-900/10 to-transparent" />
              <div class="absolute bottom-0 left-0 right-0 p-6 flex items-end justify-between">
                <h3 class="font-serif text-2xl text-white">{cat.name}</h3>
                <span class="text-white text-xl group-hover:translate-x-1 transition-transform">⟶</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Most popular -->
    {popular.length > 0 && (
      <section class="bg-rcommerce-50 border-y border-rcommerce-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
          <div class="flex items-end justify-between mb-10">
            <div>
              <p class="eyebrow text-xl">Most popular</p>
              <h2 class="font-serif text-3xl md:text-4xl font-semibold text-rcommerce-900 mt-1">Shop the favourites</h2>
            </div>
            <a href="/products" class="hidden sm:inline-block text-[13px] font-semibold uppercase tracking-button text-rcommerce-900 link-underline">
              View all
            </a>
          </div>

          {error && (
            <div class="p-4 bg-rcommerce-danger/10 text-rcommerce-danger mb-8">{error}</div>
          )}

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
            {popular.map((product) => (
              <ProductCard product={product} />
            ))}
          </div>

          <div class="mt-10 text-center sm:hidden">
            <a href="/products" class="btn-secondary">View all products</a>
          </div>
        </div>
      </section>
    )}

    {/* Promotional bundle section */}
    {content.home.promo && promoProducts.length > 0 && (
      <section class="bg-rcommerce-900 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
            <div>
              <p class="eyebrow text-xl text-rcommerce-highlight">{content.home.promo.eyebrow}</p>
              <h2 class="font-serif text-3xl md:text-4xl font-semibold mt-1">{content.home.promo.title}</h2>
              <p class="mt-3 text-rcommerce-300 max-w-xl">{'\n                ' + content.home.promo.body + '\n              '}</p>
            </div>
            <a href={content.home.promo.ctaHref} class="btn-accent">{content.home.promo.ctaLabel}</a>
          </div>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
            {promoProducts.map((pack) => (
              <ProductCard product={pack} />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- About strip -->
    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-semibold text-rcommerce-900">
        {content.home.about.heading}
      </h2>
      <div class="mt-8 space-y-5 text-rcommerce-600 leading-relaxed text-left">
        {content.home.about.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <div class="mt-10 flex items-center justify-center gap-3">
        <span class="h-px w-16 bg-rcommerce-300"></span>
        <span class="w-2 h-2 bg-rcommerce-accent rotate-45"></span>
        <span class="h-px w-16 bg-rcommerce-300"></span>
      </div>
    </section>
  </main>
  <Footer />
  </>
  )}
</Layout>
