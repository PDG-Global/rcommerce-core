---
import Layout from '../../layouts/Layout.astro';
import { brand } from '../../lib/brand';

import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title={`Sign Out | ${brand.titleSuffix}`}>
  <Nav />
  <main class="flex-1 py-16">
    <div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl font-bold mb-4">Signed Out</h1>
      <p class="text-rcommerce-600">You have been signed out successfully.</p>
      <a href="/" class="mt-6 inline-block btn-primary">Continue Shopping</a>
    </div>
  </main>
  <Footer />
  <script>
    if (typeof localStorage !== 'undefined') {
      localStorage.removeItem('rcommerce_token');
    }
  </script>
</Layout>
