---
import Layout from '../../layouts/Layout.astro';
import { brand } from '../../lib/brand';

import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import LoginForm from '../../islands/LoginForm.tsx';
const redirectParam = Astro.url.searchParams.get('redirect');
const redirectTo =
  redirectParam && redirectParam.startsWith('/') && !redirectParam.startsWith('//') ? redirectParam : '/account';
---

<Layout title={`Sign In | ${brand.titleSuffix}`}>
  <Nav />
  <main class="flex-1 py-16">
    <div class="max-w-md mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-bold mb-8 text-center">Sign In</h1>
      <LoginForm client:load redirectTo={redirectTo} />
      <p class="mt-6 text-center text-sm text-rcommerce-600">
        Don't have an account? <a href="/account/register" class="text-rcommerce-accent hover:underline">Create one</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>
