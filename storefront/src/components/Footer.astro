---
import { brand, content } from '../lib/brand';
import { API_BASE } from '../lib/api';
import { pageOverlay } from '../lib/brand/pageOverlays';

const year = new Date().getFullYear();

// Per-product SKU columns when defined; otherwise one "Shop <category>"
// column per menu category when no per-product columns are defined.
const productColumns =
  content.footer.productColumns.length > 0
    ? content.footer.productColumns
    : brand.menuCategories.map((cat) => ({
        title: cat.label,
        links: [{ label: `Shop ${cat.label}`, href: `/products/${cat.slug}` }],
      }));
// brand col + product columns + support column (+ social column when present).
const GRID_COLS: Record<number, string> = {
  3: 'md:grid-cols-3',
  4: 'md:grid-cols-4',
  5: 'md:grid-cols-5',
  6: 'md:grid-cols-6',
};
const gridColsClass =
  GRID_COLS[
    1 + productColumns.length + 1 + (content.footer.socialLinks.length > 0 ? 1 : 0)
  ] ?? 'md:grid-cols-5';

// A store may ship a bespoke footer overlay (e.g. a dark photographic band).
const FooterOverlay = pageOverlay(`${brand.slug}-footer`);
---

<footer class="mt-auto">{FooterOverlay && <FooterOverlay />}
  {!FooterOverlay && (
  <div class="bg-rcommerce-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div class="max-w-md">
          <h3 class="font-serif text-2xl">
            <span class="italic font-light text-rcommerce-300">Stay in the</span> loop
          </h3>
          <p class="mt-2 text-sm text-rcommerce-400">
            Subscribe to our mailing list to keep up to date with new products, sales and more! Get the scoop.
          </p>
        </div>
        <div class="w-full md:w-auto">
          <form id="newsletter-form" class="flex w-full md:w-auto" novalidate>
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              required
              placeholder="Email address"
              autocomplete="email"
              class="w-full md:w-80 bg-transparent border-b border-rcommerce-600 focus:border-rcommerce-highlight outline-none py-3 text-sm placeholder:text-rcommerce-500"
            />
            <button type="submit" id="newsletter-btn" class="btn-accent ml-4 shrink-0">Subscribe</button>
          </form>
          <p id="newsletter-message" class="mt-3 text-sm min-h-[1.25rem]" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>
  )}

  {!FooterOverlay && (
  <div class="bg-rcommerce-50 border-t border-rcommerce-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class={`grid grid-cols-2 ${gridColsClass} gap-10`}>
        <div class="col-span-2 md:col-span-1">
          <a href="/" class="inline-block">
            <img src={brand.logo} alt={brand.name} class="h-14 w-auto" />
          </a>
          <p class="mt-4 text-sm text-rcommerce-600 leading-relaxed">
            {content.footer.blurb}
          </p>
        </div>
        {productColumns.map((column) => (
          <div>
            <h4 class="text-[12px] font-semibold uppercase tracking-button text-rcommerce-900 mb-4">{column.title}</h4>
            <ul class="space-y-2.5 text-sm text-rcommerce-600">
              {column.links.map((link) => (
                <li><a href={link.href} class="hover:text-rcommerce-accent">{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <h4 class="text-[12px] font-semibold uppercase tracking-button text-rcommerce-900 mb-4">Support</h4>
          <ul class="space-y-2.5 text-sm text-rcommerce-600">
            {content.footer.supportLinks.map((link) => (
              <li><a href={link.href} class="hover:text-rcommerce-accent">{link.label}</a></li>
            ))}
          </ul>
        </div>
        {content.footer.socialLinks.length > 0 && (
          <div>
            <h4 class="text-[12px] font-semibold uppercase tracking-button text-rcommerce-900 mb-4">Social Links</h4>
            <ul class="space-y-2.5 text-sm text-rcommerce-600">
              {content.footer.socialLinks.map((link) => (
                <li><a href={link.href} class="hover:text-rcommerce-accent" rel="noopener">{link.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="mt-12 pt-8 border-t border-rcommerce-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm text-rcommerce-500">
        <p>© {year}, {brand.name}, All Rights Reserved</p>
        <a href="https://rcommerce.app" class="font-serif italic hover:text-rcommerce-accent transition-colors" rel="noopener">Built with rCommerce. Served at the edge.</a>
      </div>
    </div>
  </div>
  )}
</footer>

<script>
  import { API_BASE } from '../lib/api';

  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const emailInput = document.getElementById('newsletter-email') as HTMLInputElement | null;
  const submitBtn = document.getElementById('newsletter-btn') as HTMLButtonElement | null;
  const message = document.getElementById('newsletter-message');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!emailInput || !submitBtn || !message) return;

    const email = emailInput.value.trim();
    message.textContent = '';
    message.className = 'mt-3 text-sm min-h-[1.25rem]';

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      message.textContent = 'Please enter a valid email address.';
      message.classList.add('text-rcommerce-highlight');
      emailInput.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Subscribing...';
    try {
      const res = await fetch(`${API_BASE}/newsletter/subscribe`, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) {
        let errMsg = 'Something went wrong. Please try again.';
        try {
          const data = await res.json();
          errMsg = data?.error?.message || errMsg;
        } catch {
          // keep default message
        }
        throw new Error(errMsg);
      }
      message.textContent = "You're on the list! Check your inbox for what's next.";
      message.classList.add('text-rcommerce-highlight');
      emailInput.value = '';
    } catch (err: any) {
      message.textContent = err?.message || 'Something went wrong. Please try again.';
      message.classList.add('text-[#f87171]');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subscribe';
    }
  });
</script>
